# ---------------------------------------------------------------------------
# Environment variables for AI Insurance Help Center
#
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
#
# .env.local is git-ignored. Never commit real secrets.
# For Vercel deploys, set these same variables in:
#   Vercel Project → Settings → Environment Variables
# ---------------------------------------------------------------------------

# Google Gemini API key (used for chat completions and embeddings).
# Get one at: https://aistudio.google.com/app/apikey
# Free tier is sufficient for this app.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: override the default Gemini chat model.
# Leave unset to use the project default (gemini-2.0-flash).
# GEMINI_MODEL=gemini-2.0-flash

# Optional: override the default Gemini embedding model.
# Leave unset to use the project default (text-embedding-004).
# GEMINI_EMBEDDING_MODEL=text-embedding-004
